# Tab — settings reference. Copy to .env and fill in as needed.
# NEVER commit a real .env. Secrets live only in your environment.

# --- adapter selection -------------------------------------------------------
# stub (default): local, no network, no money. cli: settle through the AllScale CLI.
TAB_ADAPTER=stub

# --- AllScale credentials (required by `payout send` when TAB_ADAPTER=cli) ----
# Read from the environment only. Leave blank here.
ALLSCALE_STORE_API_KEY=
ALLSCALE_STORE_API_SECRET=
# Override the CLI binary if it is not on PATH.
ALLSCALE_CLI_BIN=
# API base the CLI session binds to. Leave blank to use the CLI's own binding.
ALLSCALE_API_BASE=
# Partner payout API origin for store-HMAC payouts. Leave blank to let the CLI
# derive it from the session environment — do not hard-code an origin.
ALLSCALE_PAYOUT_API_BASE=

# --- ledger ------------------------------------------------------------------
TAB_LEDGER_FILE=.tab/ledger.json
TAB_LEDGER_PORT=4788
TAB_LEDGER_HOST=127.0.0.1
TAB_CONFIG=tab.config.json
# Fallback credit limit when tab.config.json does not set one.
TAB_CREDIT_LIMIT=5.00

# --- identities --------------------------------------------------------------
# Buyer contact the invoice is addressed to (`invoice send --to-email`).
TAB_BUYER_EMAIL=buyer@example.com
# Seller wallet that collects (`invoice send --wallet-id`).
TAB_SELLER_WALLET_ID=
# Seller contact the payout is sent to (`payout send --receiver-email`).
TAB_SELLER_EMAIL=seller@example.com
# Buyer id when the MCP client name is unavailable.
TAB_BUYER_ID=claude

# --- settlement rail ---------------------------------------------------------
TAB_CHAIN=sepolia
TAB_STABLE_COIN=USDT
TAB_COIN=USDT

# --- buyer-side fence (`payout enable`) --------------------------------------
TAB_STORE_ID=
TAB_FENCE_SINGLE_TX=2.00
TAB_FENCE_TOTAL_CAP=20.00
TAB_FENCE_EXPIRES=2026-12-31
# Buyer-side ceiling per invoice, on top of the fence.
TAB_MAX_AUTO_PAY=5.00
TAB_POLL_INTERVAL_MS=1000
TAB_LEDGER_API=http://127.0.0.1:4788

# --- ledger UI ---------------------------------------------------------------
TAB_UI_PORT=4790
TAB_UI_HOST=127.0.0.1

# --- logging -----------------------------------------------------------------
# stdout (default) or stderr. MCP stdio servers force stderr: stdout is the protocol channel.
TAB_LOG_STREAM=stdout
